# Rebuild the vendored terminal runtime without installing npm packages or
# bundling Pi's host-provided SDK. This is a production bundle, not a check.
{
  pkgs,
  src ? builtins.path {
    path = ../btw;
    name = "btw-terminal-source";
    filter = path: _type: builtins.baseNameOf path != "candidate-runtime.ts";
  },
  sharedDefaults ? ../shared/extension-defaults.ts,
}:
let
  kit = pkgs.fetchurl {
    url = "https://registry.npmjs.org/@narumitw/pi-tui-kit/-/pi-tui-kit-0.65.6.tgz";
    hash = "sha512-uy+JGV/GamhLGamN932ZXEuBwfqsp6j+A7H0Qzjzn8ha+NDAEmKXk2nlmVpvnxeqEsu9zX0B0wQ2p9C8+XOZiQ==";
  };
  diff = pkgs.fetchurl {
    url = "https://registry.npmjs.org/diff/-/diff-9.0.0.tgz";
    hash = "sha512-svtcdpS8CgJyqAjEQIXdb3OjhFVVYjzGAPO8WGCmRbrml64SPw/jJD4GoE98aR7r25A0XcgrK3F02yw9R/vhQw==";
  };
  mermaid = pkgs.fetchurl {
    url = "https://registry.npmjs.org/grok-mermaid/-/grok-mermaid-0.2.3.tgz";
    hash = "sha512-/4KopAbsjvuRP9MdPtlDjOHUmUVEohOX73JNcsWpzAtFxh+bq5+Dhb6gzvRieLDwIPQIR3/vy8V1NNTuz4Zsmg==";
  };
  highlight = pkgs.fetchurl {
    url = "https://registry.npmjs.org/highlight.js/-/highlight.js-11.12.0.tgz";
    hash = "sha512-nbfWpyRMcMrPMmDwJB+dhX/eiaPKtc2RB+0QZskqJ3WjRA/FDS0e9hZrx8EC/lbEv8gXy98FcDbNa/dspAaJMg==";
  };
in
pkgs.runCommand "pi-btw-terminal-0.61.2" { nativeBuildInputs = [ pkgs.esbuild ]; } ''
  cp -r ${src} src
  chmod -R u+w src
  # Match candidate/settings.ts's ../../shared import without copying any
  # agent configuration or bundling Pi's host-provided SDK.
  mkdir -p shared
  cp ${sharedDefaults} shared/extension-defaults.ts
  mkdir -p node_modules/@narumitw/pi-tui-kit node_modules/diff node_modules/grok-mermaid node_modules/highlight.js "$out/licenses"
  tar -xzf ${kit} --strip-components=1 -C node_modules/@narumitw/pi-tui-kit
  tar -xzf ${diff} --strip-components=1 -C node_modules/diff
  tar -xzf ${mermaid} --strip-components=1 -C node_modules/grok-mermaid
  tar -xzf ${highlight} --strip-components=1 -C node_modules/highlight.js

  # A createRequire-bound call is opaque to esbuild. Make this one package
  # reference static so the installed runtime has no undeclared npm lookup.
  substituteInPlace node_modules/@narumitw/pi-tui-kit/dist/components/syntax-highlighting.js \
    --replace-fail 'import { createRequire } from "node:module";' 'import bundledHighlighter from "highlight.js";' \
    --replace-fail 'const require = createRequire(import.meta.url);' "" \
    --replace-fail 'require("highlight.js")' 'bundledHighlighter'

  esbuild src/candidate-entry.ts --bundle --platform=node --format=esm --target=es2022 \
    '--external:@earendil-works/*' --legal-comments=inline \
    '--banner:js=// Generated by nix/btw-terminal.nix. Source and notices: candidate/ and terminal-licenses/.' \
    --outfile="$out/candidate-runtime.ts"

  cp node_modules/@narumitw/pi-tui-kit/LICENSE "$out/licenses/pi-tui-kit-LICENSE"
  cp node_modules/diff/LICENSE "$out/licenses/diff-LICENSE"
  cp node_modules/grok-mermaid/LICENSE "$out/licenses/grok-mermaid-LICENSE"
  cp node_modules/highlight.js/LICENSE "$out/licenses/highlight.js-LICENSE"
  if [ -f node_modules/grok-mermaid/NOTICE ]; then cp node_modules/grok-mermaid/NOTICE "$out/licenses/grok-mermaid-NOTICE"; fi
''
