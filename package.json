{
  "name": "pi-agent-extensions",
  "version": "0.1.0",
  "description": "A collection of pi coding agent extensions",
  "type": "module",
  "workspaces": [
    "fetch"
  ],
  "keywords": ["pi-package"],
  "author": "rytswd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/taugoust/pi-agent-extensions.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@sinclair/typebox": "^0.34.0"
  },
  "pi": {
    "extensions": [
      "auto",
      "background-job",
      "btw",
      "workflows",
      "stamp",
      "progress",
      "cache-hit-monitor",
      "direnv",
      "fence",
      "permission-gate",
      "fetch",
      "idle-context-warning",
      "openai-accounts",
      "openai-usage",
      "pdf",
      "mac-system-theme",
      "modal-editor",
      "questionnaire",
      "ssh",
      "sandbox",
      "slow-mode",
      "subagent",
      "subagent-finalizer"
